{% set p = r.primary %}
{% set v = r.value %}
{% macro chip(status) %}<span class="chip chip-{{ status }}">{{ STATUS_TEXT.get(status, status) }}</span>{% endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Evidence pack · {{ r.program.name }}</title>
<style>
:root {
  --bg: #f7f6f2; --surface: #ffffff; --ink: #1b1c1e; --muted: #5c6066; --line: #e3e0d8;
  --accent: #1d5c48; --accent-soft: #e2eee8;
  --good: #1b6b41; --good-soft: #e0f1e6; --warn: #7d5300; --warn-soft: #faefd6;
  --bad: #9a2a2a; --bad-soft: #f7e0e0; --neutral-soft: #ecebe6;
  --chart-line: #1d5c48; --chart-band: rgba(29, 92, 72, 0.16); --chart-pre: #7b8088; --chart-grid: #e8e5de;
  --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #121314; --surface: #1a1c1e; --ink: #ecebe7; --muted: #a3a7ad; --line: #2c2f33;
    --accent: #7fc8aa; --accent-soft: #1f322b;
    --good: #7fd3a0; --good-soft: #1b3125; --warn: #f0c46a; --warn-soft: #362c17;
    --bad: #f0a0a0; --bad-soft: #3a2020; --neutral-soft: #26292c;
    --chart-line: #7fc8aa; --chart-band: rgba(127, 200, 170, 0.18); --chart-pre: #8d9299; --chart-grid: #2a2d31;
  }
}
:root[data-theme="dark"] {
  --bg: #121314; --surface: #1a1c1e; --ink: #ecebe7; --muted: #a3a7ad; --line: #2c2f33;
  --accent: #7fc8aa; --accent-soft: #1f322b;
  --good: #7fd3a0; --good-soft: #1b3125; --warn: #f0c46a; --warn-soft: #362c17;
  --bad: #f0a0a0; --bad-soft: #3a2020; --neutral-soft: #26292c;
  --chart-line: #7fc8aa; --chart-band: rgba(127, 200, 170, 0.18); --chart-pre: #8d9299; --chart-grid: #2a2d31;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.55 var(--sans); }
main { max-width: 980px; margin: 0 auto; padding: 32px 16px 64px; }
h1, h2, h3 { font-family: var(--serif); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
h1 { font-size: 2rem; margin: 0.2rem 0 0.4rem; }
h2 { font-size: 1.35rem; margin: 2.4rem 0 0.8rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
h2 .num { color: var(--muted); font-family: var(--sans); font-size: 0.9rem; font-weight: 600; margin-right: 0.5rem; }
p { margin: 0.5rem 0 0.9rem; }
.eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; font-weight: 600; color: var(--accent); }
.meta { color: var(--muted); font-size: 0.9rem; }
header { display: flex; gap: 24px; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
.grade { flex: none; width: 96px; height: 96px; border-radius: 16px; background: var(--accent-soft); color: var(--accent);
  display: grid; place-items: center; text-align: center; }
.grade b { font-family: var(--serif); font-size: 2.6rem; line-height: 1; display: block; }
.grade small { font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; }
.grade.g-D, .grade.g-insufficient { background: var(--warn-soft); color: var(--warn); }
.grade.g-insufficient b { font-size: 1.1rem; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 24px 0 8px; }
.tile { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
.tile .k { font-size: 0.78rem; color: var(--muted); }
.tile .v { font-family: var(--serif); font-size: 1.45rem; margin-top: 2px; }
.tile .s { font-size: 0.8rem; color: var(--muted); }
.headline { font-size: 1.08rem; background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--accent);
  border-radius: 10px; padding: 14px 18px; margin: 18px 0; }
.rec { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
.rec b { font-family: var(--serif); font-size: 1.1rem; }
.table-wrap { overflow-x: auto; margin: 0.6rem 0 1rem; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
table { border-collapse: collapse; width: 100%; font-size: 0.88rem; }
th, td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { font-weight: 600; color: var(--muted); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; background: var(--neutral-soft); }
tr:last-child td { border-bottom: 0; }
td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.chip { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 0.76rem; font-weight: 600; white-space: nowrap; }
.chip-pass { background: var(--good-soft); color: var(--good); }
.chip-watch { background: var(--warn-soft); color: var(--warn); }
.chip-breach, .chip-fail { background: var(--bad-soft); color: var(--bad); }
.chip-unavailable, .chip-not_run { background: var(--neutral-soft); color: var(--muted); }
.callout { border-radius: 10px; padding: 12px 16px; margin: 12px 0; }
.callout.bad { background: var(--bad-soft); color: var(--bad); }
.callout.warn { background: var(--warn-soft); color: var(--warn); }
.callout.info { background: var(--accent-soft); color: var(--ink); }
ul { padding-left: 1.2rem; }
li { margin: 0.25rem 0; }
code, .mono { font-family: var(--mono); font-size: 0.82rem; }
figure { margin: 0.6rem 0 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px; }
figcaption { color: var(--muted); font-size: 0.82rem; margin-top: 6px; }
.tl-chart { width: 100%; height: auto; display: block; }
.tl-chart .grid { stroke: var(--chart-grid); stroke-width: 1; }
.tl-chart .zero { stroke: var(--muted); stroke-width: 1; }
.tl-chart .rollout { stroke: var(--muted); stroke-dasharray: 4 4; }
.tl-chart .band { fill: var(--chart-band); }
.tl-chart .line { fill: none; stroke: var(--chart-line); stroke-width: 2; }
.tl-chart circle.post { fill: var(--chart-line); }
.tl-chart circle.pre { fill: var(--chart-pre); }
.tl-chart .whisker { stroke: var(--chart-pre); stroke-width: 1.5; }
.tl-chart text { fill: var(--muted); font: 11px var(--sans); }
.tl-chart .axis { font-size: 12px; }
details { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; margin-top: 12px; }
details summary { cursor: pointer; font-weight: 600; }
details h3 { font-size: 1.05rem; margin: 1.2rem 0 0.4rem; }
footer { margin-top: 48px; color: var(--muted); font-size: 0.8rem; border-top: 1px solid var(--line); padding-top: 16px; }
@media print {
  body { background: #fff; color: #000; font-size: 11pt; }
  main { max-width: none; padding: 0; }
  .tile, .table-wrap, figure, details, .headline { break-inside: avoid; }
  details { display: block; }
  details > *:not(summary) { display: block; }
}
@media (max-width: 560px) { h1 { font-size: 1.6rem; } .grade { width: 76px; height: 76px; } .grade b { font-size: 2rem; } }
</style>
</head>
<body>
<main>
<header>
  <div>
    <div class="eyebrow">Evidence pack</div>
    <h1>{{ r.program.name }}</h1>
    <div class="meta">{{ r.playbook.title }} · {{ r.window.start }} to {{ r.window.end }} · {{ r.window.teams }} teams · {{ r.window.units | num(0) }} {{ r.playbook.units }}{% if r.program.owner %} · Owner: {{ r.program.owner }}{% endif %}</div>
  </div>
  <div class="grade g-{{ r.grade.grade }}" title="{{ GRADE_TEXT[r.grade.grade] }}">
    <div>{% if r.grade.grade == "insufficient" %}<b>No&nbsp;number</b>{% else %}<b>{{ r.grade.grade }}</b>{% endif %}<small>Evidence grade</small></div>
  </div>
</header>

{% if p %}
<div class="tiles">
  <div class="tile"><div class="k">{{ p.label }}</div><div class="v">{{ p.relative | spct }}</div>
    <div class="s">{{ p.estimate | signed }} {{ p.unit }} · range {{ p.relative_ci_low | spct }} to {{ p.relative_ci_high | spct }}</div></div>
  <div class="tile"><div class="k">Quality guardrails</div><div class="v">{% if r.blocked %}Breached{% else %}{{ r.guardrails | selectattr("status", "equalto", "pass") | list | length }} of {{ r.guardrails | rejectattr("status", "equalto", "unavailable") | list | length }} pass{% endif %}</div>
    <div class="s">{% if r.blocked %}Value withheld{% else %}Speed only counts if quality held{% endif %}</div></div>
  {% if v %}
  <div class="tile"><div class="k">Cash ROI (P10 to P90)</div><div class="v">{{ v.roi_cash.p10 | pct }} to {{ v.roi_cash.p90 | pct }}</div>
    <div class="s">{{ r.value_status | capitalize }} · middle {{ v.roi_cash.p50 | pct }}</div></div>
  <div class="tile"><div class="k">Capacity ROI (P10 to P90)</div><div class="v">{{ v.roi_capacity.p10 | pct }} to {{ v.roi_capacity.p90 | pct }}</div>
    <div class="s">{{ v.hours.p50 | num(0) }} agent hours released</div></div>
  {% endif %}
</div>
{% endif %}

<p class="headline">{{ r.headline }}</p>
<div class="callout info rec"><b>{{ r.recommendation.action }}</b><span>{{ r.recommendation.reason }}</span></div>

<h2><span class="num">2</span>The question as registered</h2>
<ul>
  <li><b>Hypothesis:</b> {{ r.hypothesis.statement }}</li>
  <li><b>Primary metric:</b> {{ r.hypothesis.primary_metric }}{% if r.hypothesis.expected_effect is not none %} (expected {{ r.hypothesis.expected_effect | spct }}){% endif %}</li>
  <li><b>Registration:</b> {{ r.registration.summary }}</li>
  {% for d in r.registration.deviations %}<li>Deviation: {{ d }}</li>{% endfor %}
</ul>

<h2><span class="num">3</span>Design</h2>
<p><b>{{ r.design.label }}.</b></p>
<ul>
  {% for reason in r.design.reasons %}<li>{{ reason }}</li>{% endfor %}
  {% for reason in r.design.stronger_unavailable %}<li>Why not stronger: {{ reason }}</li>{% endfor %}
</ul>
<p>Evidence grade <b>{{ r.grade.grade }}</b>: {{ GRADE_TEXT[r.grade.grade] }}.</p>
<ul>{% for reason in r.grade.reasons %}<li>{{ reason }}</li>{% endfor %}</ul>

{% if r.effects %}
<h2><span class="num">4</span>Effects</h2>
<p>Headline and mix-adjusted results side by side, per {{ r.playbook.unit }}. Negative means less time. The mix-adjusted view compares {{ r.playbook.units }} only with {{ r.playbook.units }} of the same type.</p>
<div class="table-wrap"><table>
<thead><tr><th>Metric</th><th>View</th><th class="n">Effect</th><th class="n">{{ (r.lineage.bootstrap.level * 100) | int }}% range</th><th class="n">Relative</th><th class="n">Total over AI {{ r.playbook.units }}</th></tr></thead>
<tbody>
{% for e in r.effects %}
<tr><td>{{ e.metric_label }}</td><td>{{ e.view }}</td><td class="n">{{ e.estimate | signed }} {{ e.unit }}</td><td class="n">{{ e.ci_low | signed }} to {{ e.ci_high | signed }}</td><td class="n">{{ e.relative | spct(1) }}</td><td class="n">{{ e.total | signed(0) }} {{ e.unit }}</td></tr>
{% endfor %}
</tbody></table></div>

{% if r.before_after %}
<h3>Before and after, AI teams only</h3>
<p class="meta">Descriptive: no comparison group, so not causal. It shows why the headline average can mislead.</p>
<div class="table-wrap"><table>
<thead><tr><th>Metric</th><th class="n">Before AI</th><th class="n">After AI</th><th class="n">Change</th></tr></thead>
<tbody>{% for row in r.before_after %}<tr><td>{{ row.metric }}</td><td class="n">{{ row.before | num(1) }}</td><td class="n">{{ row.after | num(1) }}</td><td class="n">{{ row.change | spct }}</td></tr>{% endfor %}</tbody>
</table></div>
{% endif %}

{% if r.by_type %}
<h3>By work type</h3>
<div class="table-wrap"><table>
<thead><tr><th>Work type</th><th class="n">AI {{ r.playbook.units }}</th><th class="n">Effect (h)</th><th class="n">Range</th><th class="n">Relative</th></tr></thead>
<tbody>{% for t in r.by_type %}<tr><td>{{ t.work_type }}</td><td class="n">{{ t.after_units | num(0) }}</td><td class="n">{{ t.estimate | signed(3) }}</td><td class="n">{{ t.ci_low | signed(3) }} to {{ t.ci_high | signed(3) }}</td><td class="n">{{ t.relative | spct }}</td></tr>{% endfor %}</tbody>
</table></div>
{% endif %}
{% if r.adoption %}<p class="meta">AI was recorded on {{ r.adoption.share_touched | pct }} of AI teams' {{ r.playbook.units }} after rollout. Usage explains effects; it is never counted as value.</p>{% endif %}

<h2><span class="num">5</span>Effect over time</h2>
<figure>{{ chart | safe }}<figcaption>Mix-adjusted {{ (p.label if p else "") | lower }} by week since rollout, with {{ (r.lineage.bootstrap.level * 100) | int }}% ranges. Grey points before rollout should sit near zero; the green line shows the learning curve after it.</figcaption></figure>

<h2><span class="num">6</span>Quality guardrails</h2>
{% if r.blocked %}<div class="callout bad"><b>A guardrail breached.</b> The program is faster but worse, so its value is withheld.</div>{% endif %}
<div class="table-wrap"><table>
<thead><tr><th>Guardrail</th><th>Allowed</th><th>Status</th><th>Detail</th></tr></thead>
<tbody>{% for g in r.guardrails %}<tr><td>{{ g.label }}</td><td>{{ g.threshold }}</td><td>{{ chip(g.status) }}</td><td>{{ g.detail }}</td></tr>{% endfor %}</tbody>
</table></div>

<h2><span class="num">7</span>Diagnostics</h2>
<div class="table-wrap"><table>
<thead><tr><th>Check</th><th>Result</th><th>Detail</th></tr></thead>
<tbody>{% for c in r.diagnostics %}<tr><td>{{ c.name }}</td><td>{{ chip(c.status) }}</td><td>{{ c.detail }}</td></tr>{% endfor %}</tbody>
</table></div>

<h2><span class="num">8</span>Value and ROI</h2>
{% if v %}
{% if r.value_status == "indicative" %}<div class="callout warn">Indicative only: the evidence grade does not count toward measured value. Shown for context.</div>{% endif %}
{% if r.value_status == "withheld" %}<div class="callout bad">Withheld: a quality guardrail breached.</div>{% endif %}
<p>Period: {{ v.months | num(1) }} months from first rollout. Ranges from {{ v.simulations | num(0) }} simulations combining the measured effect's uncertainty with the assumptions in section 10.</p>
<div class="table-wrap"><table>
<thead><tr><th></th><th class="n">Low (P10)</th><th class="n">Middle (P50)</th><th class="n">High (P90)</th></tr></thead>
<tbody>
<tr><td>Agent hours released</td><td class="n">{{ v.hours.p10 | num(0) }}</td><td class="n">{{ v.hours.p50 | num(0) }}</td><td class="n">{{ v.hours.p90 | num(0) }}</td></tr>
<tr><td>Capacity value</td><td class="n">{{ v.capacity_value.p10 | money(currency) }}</td><td class="n">{{ v.capacity_value.p50 | money(currency) }}</td><td class="n">{{ v.capacity_value.p90 | money(currency) }}</td></tr>
<tr><td>Cash value</td><td class="n">{{ v.cash_value.p10 | money(currency) }}</td><td class="n">{{ v.cash_value.p50 | money(currency) }}</td><td class="n">{{ v.cash_value.p90 | money(currency) }}</td></tr>
<tr><td>Total cost</td><td class="n">{{ v.cost.p10 | money(currency) }}</td><td class="n">{{ v.cost.p50 | money(currency) }}</td><td class="n">{{ v.cost.p90 | money(currency) }}</td></tr>
<tr><td><b>Capacity ROI</b></td><td class="n">{{ v.roi_capacity.p10 | pct }}</td><td class="n">{{ v.roi_capacity.p50 | pct }}</td><td class="n">{{ v.roi_capacity.p90 | pct }}</td></tr>
<tr><td><b>Cash ROI</b></td><td class="n">{{ v.roi_cash.p10 | pct }}</td><td class="n">{{ v.roi_cash.p50 | pct }}</td><td class="n">{{ v.roi_cash.p90 | pct }}</td></tr>
<tr><td>Cost per agent hour released</td><td class="n">{{ v.cost_per_hour.p10 | money(currency) }}</td><td class="n">{{ v.cost_per_hour.p50 | money(currency) }}</td><td class="n">{{ v.cost_per_hour.p90 | money(currency) }}</td></tr>
</tbody></table></div>
<p>Payback, middle case: {{ v.payback_cash_months.p50 | months }} on a cash basis; {{ v.payback_capacity_months.p50 | months }} on a capacity basis.</p>
{% for n in v.notes %}<p class="meta">{{ n }}</p>{% endfor %}
{% if r.deflection %}
<h3>Verified deflection</h3>
<p>{{ r.deflection.resolved | num(0) }} self-service resolutions: {{ r.deflection.verified | num(0) }} verified, {{ r.deflection.false | num(0) }} false ({{ r.deflection.false_rate | pct(1) }} came back within 7 days). {{ r.deflection.hours_avoided | num(0) }} agent hours avoided. {{ r.deflection.reason }}</p>
{% endif %}
{% if r.costs and r.costs.lines %}
<h3>Costs for the period</h3>
<div class="table-wrap"><table>
<thead><tr><th>Component</th><th>Description</th><th>Basis</th><th class="n">Low</th><th class="n">Most likely</th><th class="n">High</th></tr></thead>
<tbody>{% for c in r.costs.lines %}<tr><td>{{ c.component }}</td><td>{{ c.description }}</td><td>{{ c.basis }}</td><td class="n">{{ c.low | money(currency) }}</td><td class="n">{{ c.mid | money(currency) }}</td><td class="n">{{ c.high | money(currency) }}</td></tr>{% endfor %}</tbody>
</table></div>
{% endif %}
{% else %}
<p>Value could not be computed.</p>
{% endif %}

<h2><span class="num">9</span>Claimed versus proven</h2>
{% if r.claimed %}
<div class="table-wrap"><table>
<thead><tr><th>Source</th><th class="n">Claimed hours</th><th class="n">Claimed value</th><th class="n">Measured hours (P10 to P90)</th><th>Note</th></tr></thead>
<tbody>{% for c in r.claimed %}<tr><td>{{ c.source }}</td><td class="n">{{ c.hours_saved | num(0) }}</td><td class="n">{{ c.value | money(currency) }}</td><td class="n">{% if c.measured_hours %}{{ c.measured_hours.p10 | num(0) }} to {{ c.measured_hours.p90 | num(0) }}{% else %}n/a{% endif %}</td><td>{{ c.note or "" }}</td></tr>{% endfor %}</tbody>
</table></div>
<p class="meta">Claimed figures are grade E: shown for comparison, never added to measured value.</p>
{% else %}<p>No vendor or dashboard estimate was supplied.</p>{% endif %}

<h2><span class="num">10</span>Assumptions</h2>
<div class="table-wrap"><table>
<thead><tr><th>Assumption</th><th class="n">Low</th><th class="n">Most likely</th><th class="n">High</th><th>Unit</th><th>Owner</th><th>Agreed</th></tr></thead>
<tbody>{% for a in r.assumptions %}<tr><td>{{ a.name }}</td><td class="n">{{ a.low | num(2) }}</td><td class="n">{{ a.mid | num(2) }}</td><td class="n">{{ a.high | num(2) }}</td><td>{{ a.unit }}</td><td>{{ a.owner or "not recorded" }}</td><td>{{ a.date or "not recorded" }}</td></tr>{% endfor %}</tbody>
</table></div>
{% endif %}

<h2><span class="num">11</span>Data lineage</h2>
<div class="table-wrap"><table>
<thead><tr><th>File</th><th class="n">Rows</th><th>Modified</th><th>SHA-256</th></tr></thead>
<tbody>{% for f in r.lineage.files %}<tr><td>{{ f.path.split("/")[-1] }}</td><td class="n">{{ f.rows | num(0) }}</td><td>{{ f.modified }}</td><td class="mono">{{ f.sha256[:16] }}…</td></tr>{% endfor %}</tbody>
</table></div>
<ul>
{% for k, n in r.lineage.exclusions.items() %}<li>Excluded, {{ k }}: {{ n | num(0) }}</li>{% else %}<li>No records excluded.</li>{% endfor %}
{% for n in r.notes %}<li>{{ n }}</li>{% endfor %}
</ul>
<p class="meta">Probative Labs {{ r.lineage.code.probative }} (git <span class="mono">{{ (r.lineage.code.git or "n/a")[:12] }}</span>) · configuration <span class="mono">{{ r.lineage.config_sha256[:12] }}</span> · run {{ r.lineage.run_at }}</p>

<h2><span class="num">12</span>Recommendation</h2>
<p><b>{{ r.recommendation.action }}.</b> {{ r.recommendation.reason }}</p>
<p class="meta">A rule-based suggestion from the evidence above. The decision belongs to the program owner and finance.</p>

<details>
<summary>Method appendix</summary>
{% for s in sections %}
<h3>{{ s.title }}</h3>
{% for para in s.paras %}<p>{{ para }}</p>{% endfor %}
{% if s["items"] %}<ul>{% for i in s["items"] %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}
{% endfor %}
</details>

<footer>Generated by Probative Labs, open-source AI impact measurement. Results are team-level only; no individual is scored. Method: docs/methodology.md.</footer>
</main>
</body>
</html>
